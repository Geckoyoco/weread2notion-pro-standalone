# Copy to .env for local development. Never commit real values.
WEREAD_API_KEY=
NOTION_TOKEN=
NOTION_PAGE=

# Optional: use when the heatmap placeholder cannot be discovered automatically.
HEATMAP_BLOCK_ID=

# Optional template database name overrides.
BOOK_DATABASE_NAME=书架
CHAPTER_DATABASE_NAME=章节
READ_DATABASE_NAME=阅读记录

# Optional full refresh switches.
FULL_SYNC=false
FULL_SYNC_NOTES=false

# Destructive: delete Notion note blocks missing from the latest WeRead response.
ALLOW_REMOTE_DELETIONS=false
